<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.gcsj4.mapper.InfoMapper">

    <resultMap id="BaseResultMap" type="org.example.gcsj4.model.entity.Info">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="video_name" property="videoName" />
        <result column="video_suffix" property="videoSuffix" />
        <result column="video_save_path" property="videoSavePath" />
        <result column="video_duration" property="videoDuration" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="Base_Column_List">
            `id`,
            `user_id`,
            `video_name`,
            `video_suffix`,
            `video_save_path`,
            `video_duration`,
            `status`,
            `create_time`
    </sql>

</mapper>
